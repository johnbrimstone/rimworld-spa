      <li><multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity><statOffsets><MentalBreakThreshold>-0.10</MentalBreakThreshold></statOffsets><minSeverity>1.35</minSeverity></li>
      <li><multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity><statOffsets><MentalBreakThreshold>-0.10</MentalBreakThreshold></statOffsets><minSeverity>1.40</minSeverity></li>
