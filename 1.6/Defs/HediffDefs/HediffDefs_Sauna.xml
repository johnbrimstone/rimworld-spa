<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Shared shape: a decaying, non-bad Hediff granted only on full-session completion
    (see JobDriver_UseSauna — interrupted sessions grant nothing, no partial buff).
    Severity is set to the room's intensity multiplier (1.0 baseline, up to 1.5 with 3
    max-value facilities linked — SaunaUtility.GetIntensityMultiplier).

    Each concrete archetype def below repeats the SAME 100%-baseline statOffsets across
    10 stages (one per actually-reachable severity value — see ThoughtDefs_Sauna.xml for
    why exactly 10), all with multiplyStatChangesBySeverity, rather than one stage. This
    isn't for the stat math — multiplyStatChangesBySeverity already scales correctly off
    the live severity value no matter how many stages exist. It's because the paired
    ThoughtDef's mood picks its own stage by mirroring this Hediff's CurStageIndex
    (ThoughtWorker_Hediff), and CurStageIndex only advances if the Hediff itself actually
    has multiple stages to advance through. A single-stage Hediff (what this used to be)
    left CurStageIndex permanently at 0, so mood was silently stuck at its lowest value
    regardless of actual intensity even though the stats scaled correctly — caught via
    in-game testing, not something the game errors on.
  -->
  <HediffDef Name="SaunaBuffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1.5</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

