<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Shared shape for every 1x1 heater variant. Only label/description and the
    CompProperties_SaunaHeater archetype value differ per concrete def below.
    comps are NOT inherited here — RimWorld's XML inheritance replaces list fields
    wholesale rather than merging them, so each concrete def repeats its own <comps>
    block (CompPowerTrader + CompFlickable + CompProperties_SaunaHeater) instead of
    fighting that.

    ParentName="BuildingBase" (matching SaunaColdPlungeTub's own pattern) was missing
    here originally — without it this def fell back to ThingDef's raw C# default
    tickerType (Never) instead of BuildingBase's Normal, so the heater's own CompTick()
    silently never fired for ANY comp (heat pusher, power scaling, motes). Buff-granting
    itself was unaffected since that runs on the pawn's job tick, not the heater's — see
    JobDriver_UseSauna. Explicit <tickerType> below as well, belt-and-suspenders.
  -->
  <ThingDef Name="SaunaHeaterBase_1x1" ParentName="BuildingBase" Abstract="True">
    <thingClass>SpaMod.Building_SaunaHeater</thingClass>
    <category>Building</category>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <!-- Placeholder art reusing the vanilla heater sprite until real textures are made (see spec's Asset Pipeline section). -->
    <graphicData>
      <texPath>Things/Building/Misc/TempControl/Heater</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <designationCategory>Furniture</designationCategory>
    <statBases>
      <Beauty>4</Beauty>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>15</Mass>
    </statBases>
    <costList>
      <Steel>100</Steel>
    </costList>
    <researchPrerequisites>
      <li>Sauna_Research</li>
    </researchPrerequisites>
    <!-- joyKind deliberately NOT set here — each concrete def below sets its own,
         per the design spec's 3-bucket Recreation Type mapping (Phase 4). -->
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="SaunaHeaterBase_1x1">
    <defName>SaunaHeater_Serenity_1x1</defName>
    <label>sauna heater (meditation brazier)</label>
    <description>An electric brazier that heats a sauna room and fills it with the scent of incense, encouraging quiet reflection. Grants the Serenity buff to anyone who relaxes near it.</description>
    <building>
      <joyKind>Meditative</joyKind>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>800</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <!-- Warm-toned light radius while active — spec: "CompGlower only... no animated
           flicker texture for now." Uniform across archetypes, no per-theme variation. -->
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(255, 180, 120, 0)</glowColor>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>SaunaSingingBowl</li>
          <li>SaunaCandleRack</li>
          <li>SaunaPrayerCandleBundle</li>
          <li>SaunaMoodyGlowlight</li>
          <li>SaunaHerbBasket</li>
          <li>SaunaWaterfall</li>
          <li>SaunaHeatedStonePile</li>
        </linkableFacilities>
      </li>
      <!-- Psyfocus gain (Royalty DLC only, skipped entirely otherwise): only takes
           effect once fully decorated — see FocusStrengthOffset_SaunaFullyDecorated.
           "Minimal" focus type is Royalty's unrestricted category (no trait/backstory/
           title requirement), matching the spec's "not limited to Serenity" framing. -->
      <li Class="CompProperties_MeditationFocus" MayRequire="Ludeon.RimWorld.Royalty">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Minimal</li>
        </focusTypes>
        <offsets>
          <li Class="SpaMod.FocusStrengthOffset_SaunaFullyDecorated">
            <offset>0.25</offset>
          </li>
        </offsets>
      </li>
      <!-- Thin incense-smoke fleck (spec's "match the theme" mote table). -->
      <li Class="SpaMod.CompProperties_SaunaHeaterMotes" />
      <!-- Temperature gate (Room & Sauna Definition / Resolved Decision #30-31): actively
           warms the room toward the archetype's expected range, capped at its top so it
           doesn't overheat past it. A meditation brazier runs mild/cozy, not hot. -->
      <li Class="SpaMod.CompProperties_SaunaHeaterClimateControl">
        <heatRatePerInterval>2.5</heatRatePerInterval>
      </li>
      <li Class="SpaMod.CompProperties_SaunaHeater">
        <archetype>Serenity</archetype>
        <heatTier>Small</heatTier>
        <ratedRoomSize>12</ratedRoomSize>
        <minGateTemperature>30</minGateTemperature>
        <maxGateTemperature>40</maxGateTemperature>
      </li>
    </comps>
  </ThingDef>

