<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Decorative in-room facilities. Linked to a heater via CompFacility/CompAffectedByFacilities
    (vanilla's Tool-Cabinet-boosts-Machining-Table system) using the default proximity/line-of-
    sight rules (no mustBePlacedAdjacent, default maxDistance=8 — generous for a sauna-sized
    room). Each also carries a custom SpaMod.CompProperties_SaunaFacility with a facilityBonus
    point value (no vanilla equivalent field exists) — the room's intensity is 100% + 5% per
    point, summed across the 3 highest-value linked facilities (see
    SaunaUtility.GetIntensityMultiplier / GetTopFacilityBonusPoints). No CompProperties_Facility
    statOffsets: the mod reads facilityBonus directly rather than the generic stat pipeline,
    since picking the top-3-by-value (not just first-3-linked) needs custom selection logic
    either way. Every heater ThingDef lists all of these in its CompProperties_AffectedByFacilities
    — bench/decor "theme" pairing per the design spec is cosmetic only, not enforced here.

    ParentName="BuildingBase" for the same reasons as the heaters/bench: MapMeshOnly
    drawing, rubble filth, repair effect, resource refund on destruction, sell factor.
    No tickerType here — CompFacility only ticks for mustBePlacedFacingThingLinear, which
    none of these use — so only SaunaHerbBasket (CompRefuelable) opts in to ticking.
  -->
  <ThingDef Name="SaunaFacilityBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <selectable>true</selectable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <designationCategory>Furniture</designationCategory>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaSingingBowl</defName>
    <label>singing bowl</label>
    <description>A meditation singing bowl. Its resonant tone lingers in a sauna room, deepening whatever calm the heater already grants. Static — no upkeep.</description>
    <!-- Placeholder art pending real textures (see spec's Asset Pipeline section). -->
    <graphicData>
      <texPath>Things/Item/Resource/Silver</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <fillPercent>0.15</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>400</WorkToBuild>
      <Mass>3</Mass>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>3</facilityBonus>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaCandleRack</defName>
    <label>candle rack</label>
    <description>A rack of decorative candles. Purely for ambience — the flames are cosmetic and carry no fire risk.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Chemfuel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <fillPercent>0.15</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>300</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>2</facilityBonus>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaPrayerCandleBundle</defName>
    <label>prayer candle bundle</label>
    <!-- Same facility slot/stats as SaunaCandleRack — a Serenity-themed reskin for visual
         variety, not a separate mechanical bonus (per the design spec). -->
    <description>A bundle of prayer candles, themed for a meditation sauna. Mechanically identical to a candle rack — just a different look.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Jade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
    <fillPercent>0.15</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>300</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>2</facilityBonus>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaMoodyGlowlight</defName>
    <label>moody glowlight</label>
    <description>A low, warm light fixture. The cheapest universal decor option — fits any sauna theme.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Gold</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.6, 0.6)</drawSize>
    </graphicData>
    <fillPercent>0.1</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>300</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>2</facilityBonus>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255, 200, 150, 0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaHerbBasket</defName>
    <label>herb basket</label>
    <description>A basket of aromatic herbs, periodically replenished. A stronger bonus than static decor, but needs upkeep.</description>
    <!-- CompRefuelable burns fuel in CompTick(); ThingDef's default tickerType is Never
         (BuildingBase doesn't change it), so without this the basket never emptied and
         the upkeep that justifies its higher facilityBonus didn't exist. -->
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Item/Resource/Medicine/MedicineHerbal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.6, 0.6)</drawSize>
    </graphicData>
    <fillPercent>0.1</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>250</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <!-- 4 rather than the 3 other static-decor items get, compensating for the ongoing
           upkeep cost below (Resolved Decision #24). -->
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>4</facilityBonus>
      </li>
      <!-- Flavor only for now: an empty basket still counts toward the linked-facility
           total (CompFacility.CanBeActive only checks power, not fuel). Gating the count
           on fuel level would need a small custom check — worth adding later if desired. -->
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.4</fuelConsumptionRate>
        <fuelCapacity>6</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>true</showFuelGizmo>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaWaterfall</defName>
    <label>small waterfall</label>
    <!-- Spec also calls for a stone-floor-beneath placement requirement; skipped for this
         pass (would need a custom PlaceWorker) — the facility linking itself is unaffected. -->
    <description>A small decorative waterfall with ambient trickling sound.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Neutroamine</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <fillPercent>0.3</fillPercent>
    <pathCost>30</pathCost>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>3</facilityBonus>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="SaunaFacilityBase">
    <defName>SaunaHeatedStonePile</defName>
    <label>heated stone pile</label>
    <description>A pile of heated stones with a visual steam-pour flavor.</description>
    <graphicData>
      <texPath>Things/Item/Resource/StoneBlocks</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.8, 0.8)</drawSize>
    </graphicData>
    <fillPercent>0.2</fillPercent>
    <pathCost>14</pathCost>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>400</WorkToBuild>
      <Mass>15</Mass>
      <Beauty>3</Beauty>
    </statBases>
    <!-- "Any rock type" per the design spec — built from a stuff category rather than a
         fixed resource, so the player can choose whichever stone block they have. -->
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>35</costStuffCount>
    <comps>
      <li Class="CompProperties_Facility" />
      <li Class="SpaMod.CompProperties_SaunaFacility">
        <facilityBonus>3</facilityBonus>
      </li>
    </comps>
  </ThingDef>

</Defs>
